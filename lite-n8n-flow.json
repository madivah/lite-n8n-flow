    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst errorTypes = response.aggregations?.error_types?.buckets || {};\n\nconst data = {\n  '5xx': errorTypes['5xx']?.doc_count || 0,\n  'connection_refused': errorTypes['connection_refused']?.doc_count || 0,\n  'database': errorTypes['database']?.doc_count || 0,\n  'timeout': errorTypes['timeout']?.doc_count || 0\n};\n\nconst total = Object.values(data).reduce((sum, count) => sum + count, 0);\n\n// ساخت پیام برای ارسال\nlet message = '*گزارش خطاهای زیرساختی - ۱۰ دقیقه اخیر*\\n\\n';\nmessage += `*مجموع کل خطاها:* ${total.toLocaleString()}\\n\\n`;\nmessage += ' تفکیک خطاها:*\\n';\nmessage += `  • خطاهای 5xx (سرور): ${data['5xx'].toLocaleString()}\\n`;\nmessage += `  •  خطاهای اتصال (Connection Refused): ${data['connection_refused'].toLocaleString()}\\n`;\nmessage += `  •  خطاهای دیتابیس: ${data['database'].toLocaleString()}\\n`;\nmessage += `  •  خطاهای تایم‌اوت: ${data['timeout'].toLocaleString()}\\n\\n`;\n\n// اضافه کردن خطای غالب\nreturn {\n  json: {\n    text: message,\n    // برای ارسال به ایمیل\n    mail_message: {\n      blocks: [\n        {\n          type: 'section',\n          text: {\n            type: 'mrkdwn',\n            text: message\n          }\n        }\n      ]\n    },\n    // داده‌های عددی برای پردازش بیشتر\n    metrics: data,\n    total: total\n  }\n};"
      },
